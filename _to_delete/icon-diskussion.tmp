          <pattern id="shirtdots2" width="7" height="7" patternUnits="userSpaceOnUse"><rect width="7" height="7" fill="#E6F1FC"/><circle cx="2" cy="2" r="1.1" fill="#1E6FD0"/><circle cx="5.5" cy="5.5" r="1" fill="#FF6B3D"/></pattern>
        </defs>
